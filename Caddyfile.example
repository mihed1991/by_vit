# Replace shop.example.com after purchasing and configuring the domain.
shop.example.com {
  encode zstd gzip
  reverse_proxy 127.0.0.1:3000

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    -Server
  }

  log {
    output file /var/log/caddy/byvit-access.log
  }
}
