# Runtime
NODE_ENV=production
PORT=3000
BYVIT_PUBLIC_URL=https://shop.example.com
BYVIT_TRUST_PROXY=true
BYVIT_ALLOWED_ORIGINS=https://shop.example.com

# Set a unique password before the first production start.
BYVIT_ADMIN_PASSWORD=replace-with-a-long-unique-password
BYVIT_SESSION_TTL_MS=43200000

# Persistent application data
BYVIT_DATA_DIR=/app/runtime/data
BYVIT_BACKUP_DIR=/app/runtime/data/backups
BYVIT_UPLOAD_DIR=/app/runtime/data/uploads
BYVIT_STORAGE_DRIVER=postgres
BYVIT_STORAGE_PERSISTENT=true
BYVIT_MEDIA_DRIVER=file
BYVIT_MEDIA_PERSISTENT=true
BYVIT_MAX_BACKUPS=30
BYVIT_UPLOAD_MAX_BYTES=26214400

# PostgreSQL
POSTGRES_DB=byvit
POSTGRES_USER=byvit
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://byvit:replace-with-a-long-random-database-password@postgres:5432/byvit
BYVIT_DATABASE_POOL_SIZE=10
BYVIT_DATABASE_SSL=false
BYVIT_DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Use long random values. Keep this file outside Git.
BYVIT_BACKUP_TOKEN=replace-with-a-long-random-token
BYVIT_BACKUP_EXPORT_DIR=/app/offsite-backups
BYVIT_BACKUP_EXPORT_KEEP=14

# Telegram (optional until the bot is connected)
BYVIT_ADMIN_RECOVERY_BOT_TOKEN=
BYVIT_ADMIN_RECOVERY_CHAT_IDS=

# MoySklad inventory sync. Keep the token server-side only.
MOYSKLAD_ENABLED=false
MOYSKLAD_TOKEN=
MOYSKLAD_API_BASE=https://api.moysklad.ru/api/remap/1.2
MOYSKLAD_STOCK_ENDPOINT=/report/stock/all
MOYSKLAD_SYNC_INTERVAL_MS=300000
MOYSKLAD_WEBHOOK_SECRET=
